# --- Приложение ---
APP_ENV=local
LOG_LEVEL=debug
JWT_SECRET=dev-change-me-please-32chars-min

# --- Postgres ---
POSTGRES_USER=ledger
POSTGRES_PASSWORD=ledger
POSTGRES_DB=ledgerpay
POSTGRES_PORT=5432
DB_DSN=postgres://ledger:ledger@localhost:5432/ledgerpay?sslmode=disable

# --- Redis ---
REDIS_ADDR=localhost:6379
REDIS_PORT=6379

# --- Redpanda / Kafka ---
KAFKA_BROKERS=localhost:19092
KAFKA_TOPIC_TRANSFERS=ledger.transfer.completed
REDPANDA_KAFKA_PORT=19092
REDPANDA_ADMIN_PORT=9644

# --- Порты сервисов на хосте ---
AUTH_HTTP_PORT=8081
AUTH_GRPC_PORT=50051

ACCOUNT_HTTP_PORT=8082
ACCOUNT_GRPC_PORT=50052

TRANSACTION_HTTP_PORT=8083
TRANSACTION_GRPC_PORT=50053

NOTIFICATIONS_HTTP_PORT=8084
NOTIFICATIONS_GRPC_PORT=50054

GATEWAY_HTTP_PORT=8080
